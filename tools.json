{
  "tools": {
    "sqlmap": {
      "bin": "sqlmap",
      "pkg": "sqlmap",
      "cat": "web",
      "desc": "SQL injection automated (classic/blind/time/union, DB dump)",
      "args": [
        {"flag": "-u", "prompt": "target url (device own)", "required": true},
        {"flag": "--data", "prompt": "POST body (optional)"},
        {"flag": "--dbs", "prompt": "enumerate DBs? [y/N]", "bool": true},
        {"flag": "--tables", "prompt": "enumerate tables? [y/N]", "bool": true},
        {"flag": "--dump", "prompt": "dump data? [y/N]", "bool": true},
        {"flag": "--level", "prompt": "level [1-5]", "default": "3"},
        {"flag": "--risk", "prompt": "risk [1-3]", "default": "2"},
        {"flag": "--batch", "const": true}
      ],
      "notes": "Gunakan --batch untuk non-interaktif. Output tersimpan di ~/.sqlmap/output."
    },
    "bettercap": {
      "bin": "bettercap",
      "pkg": "bettercap",
      "cat": "net",
      "desc": "MITM framework (arp spoof, dns spoof, hsts hijack, http proxy)",
      "args": [
        {"flag": "-iface", "prompt": "interface [wlan0]", "default": "wlan0"},
        {"flag": "-eval", "prompt": "caplet/script (optional, e.g. 'set arp.spoof.targets IP; arp.spoof on')"},
        {"flag": "-caplet", "prompt": "caplet file (optional)"}
      ],
      "needs_root": true,
      "notes": "Restore otomatis: ARP cache heal on exit (bettercap default)."
    },
    "nmap": {
      "bin": "nmap",
      "pkg": "nmap",
      "cat": "recon",
      "desc": "port scan + service detect + NSE scripts",
      "args": [
        {"flag": "target", "prompt": "target host/cidr (device own)", "required": true},
        {"flag": "-p", "prompt": "ports [1-1000]", "default": "1-1000"},
        {"flag": "-sV", "prompt": "service version detect? [y/N]", "bool": true},
        {"flag": "-O", "prompt": "OS detect? [y/N]", "bool": true},
        {"flag": "-T", "prompt": "timing [0-5]", "default": "4"}
      ]
    },
    "hydra": {
      "bin": "hydra",
      "pkg": "hydra",
      "cat": "auth",
      "desc": "login brute (ssh/ftp/http-form etc) — own service only",
      "args": [
        {"flag": "target", "prompt": "target host:port (own service)", "required": true},
        {"flag": "-l", "prompt": "login/user", "required": true},
        {"flag": "-P", "prompt": "password wordlist [wordlist.txt]", "default": "wordlist.txt"},
        {"flag": "service", "prompt": "service (ssh/ftp/http-post-form...)", "default": "ssh"}
      ],
      "needs_root": false
    },
    "ffuf": {
      "bin": "ffuf",
      "pkg": "ffuf",
      "cat": "web",
      "desc": "fast web fuzzer (path/param/vhost)",
      "args": [
        {"flag": "-u", "prompt": "target url with FUZZ (device own)", "required": true},
        {"flag": "-w", "prompt": "wordlist [subd.txt]", "default": "subd.txt"},
        {"flag": "-mc", "prompt": "match codes [200,301]", "default": "200,301,302"},
        {"flag": "-t", "prompt": "threads [40]", "default": "40"}
      ]
    },
    "dnschef": {
      "bin": "dnschef",
      "pkg": null,
      "cat": "net",
      "desc": "fake DNS proxy (lab DNS spoof) — pip install",
      "pip": "dnschef",
      "args": [
        {"flag": "--fakeip", "prompt": "fake ip [127.0.0.1]", "default": "127.0.0.1"},
        {"flag": "--fakedomains", "prompt": "domains (comma, e.g. test.lab)"},
        {"flag": "--port", "prompt": "listen port [53]", "default": "53"}
      ],
      "needs_root": true
    },
    "tcpdump": {
      "bin": "tcpdump",
      "pkg": "tcpdump",
      "cat": "net",
      "desc": "packet capture (pcap for tshark/wireshark)",
      "args": [
        {"flag": "-i", "prompt": "interface [any]", "default": "any"},
        {"flag": "-w", "prompt": "output pcap [data/cap.pcap]", "default": "data/cap.pcap"},
        {"flag": "filter", "prompt": "bpf filter (optional, e.g. port 80)"}
      ],
      "needs_root": true
    },
    "tshark": {
      "bin": "tshark",
      "pkg": null,
      "cat": "net",
      "desc": "CLI packet analysis (already installed)",
      "args": [
        {"flag": "-r", "prompt": "read pcap [data/cap.pcap]", "default": "data/cap.pcap"},
        {"flag": "-Y", "prompt": "display filter (optional, e.g. http)"},
        {"flag": "-T", "prompt": "output format [fields]", "default": "fields"}
      ]
    },
    "ettercap": {
      "bin": "ettercap",
      "pkg": null,
      "cat": "net",
      "desc": "MITM alternative (text UI) — not in termux repo, skip unless source-built",
      "unavailable": true
    },
    "hping3": {
      "bin": "hping3",
      "pkg": "hping3",
      "cat": "net",
      "desc": "packet crafting/flood — TCP/UDP/ICMP test (lab only)",
      "args": [
        {"flag": "target", "prompt": "target ip (device own)", "required": true},
        {"flag": "-p", "prompt": "dest port [80]", "default": "80"},
        {"flag": "-c", "prompt": "packet count [100]", "default": "100"},
        {"flag": "-i", "prompt": "interval (u10000=10ms) [u10000]", "default": "u10000"},
        {"flag": "--syn", "prompt": "SYN mode? [y/N]", "bool": true}
      ],
      "needs_root": true,
      "notes": "Lab load/packet test only. Default bounded (-c 100)."
    },
    "dnsmasq": {
      "bin": "dnsmasq",
      "pkg": "dnsmasq",
      "cat": "net",
      "desc": "fake DNS via hosts entries — simplest lab DNS spoof",
      "args": [
        {"flag": "--no-daemon", "const": true},
        {"flag": "--address", "prompt": "fake entry (/test.lab/127.0.0.1)", "required": true},
        {"flag": "-p", "prompt": "listen port [5353]", "default": "5353"}
      ],
      "notes": "Non-root alt to port 53: use -p 5353. Point device DNS to this host."
    },
    "dsniff": {
      "bin": "arpspoof",
      "pkg": "dsniff",
      "cat": "net",
      "desc": "classic MITM suite: arpspoof, dnsspoof, dsniff, macof",
      "args": [
        {"flag": "-i", "prompt": "interface [wlan0]", "default": "wlan0"},
        {"flag": "-t", "prompt": "victim ip (device own)", "required": true},
        {"flag": "gateway", "prompt": "gateway ip [192.168.1.1]", "default": "192.168.1.1"}
      ],
      "needs_root": true,
      "notes": "arpspoof is the binary; suite also has dnsspoof/dsniff/macof."
    },
    "ab": {
      "bin": "ab",
      "pkg": "apache2-utils",
      "cat": "load",
      "desc": "ApacheBench — standard HTTP load test (no DoS)",
      "args": [
        {"flag": "-n", "prompt": "total requests [1000]", "default": "1000"},
        {"flag": "-c", "prompt": "concurrency [50]", "default": "50"},
        {"flag": "url", "prompt": "target url (device own)", "required": true}
      ]
    },
    "siege": {
      "bin": "siege",
      "pkg": "siege",
      "cat": "load",
      "desc": "load test with URL file mode + delays",
      "args": [
        {"flag": "-c", "prompt": "concurrent users [25]", "default": "25"},
        {"flag": "-t", "prompt": "duration [30S]", "default": "30S"},
        {"flag": "url", "prompt": "target url (device own)", "required": true}
      ]
    },
    "wrk": {
      "bin": "wrk",
      "pkg": "wrk",
      "cat": "load",
      "desc": "modern HTTP benchmark (LuaJIT scripts)",
      "args": [
        {"flag": "-t", "prompt": "threads [4]", "default": "4"},
        {"flag": "-c", "prompt": "connections [50]", "default": "50"},
        {"flag": "-d", "prompt": "duration [30s]", "default": "30s"},
        {"flag": "url", "prompt": "target url (device own)", "required": true}
      ]
    },
    "mitmproxy": {
      "bin": "mitmdump",
      "pkg": "mitmproxy",
      "cat": "web",
      "desc": "HTTPS MITM proxy — install CA on own device, inspect TLS traffic",
      "args": [
        {"flag": "-p", "prompt": "listen port [8080]", "default": "8080"},
        {"flag": "-w", "prompt": "save flows to (optional, e.g. data/flows.mitm)"},
        {"flag": "--mode", "prompt": "mode [regular/transparent/upstream:]", "default": "regular"}
      ],
      "notes": "Install CA on own device: visit http://mitm.it after starting. Transparent mode needs root."
    },
    "goldeneye": {
      "bin": "goldeneye",
      "pkg": "goldeneye",
      "cat": "load",
      "desc": "HTTP DoS (layer 7) — lab-only, bounded run",
      "args": [
        {"flag": "url", "prompt": "target url (device own)", "required": true},
        {"flag": "-w", "prompt": "workers [10]", "default": "10"},
        {"flag": "-s", "prompt": "sockets [100]", "default": "100"}
      ],
      "needs_root": false,
      "notes": "Lab-only. Prefer ab/wrk for legitimate load testing."
    },
    "macchanger": {
      "bin": "macchanger",
      "pkg": "macchanger",
      "cat": "net",
      "desc": "MAC address spoof — test MAC filtering on own network",
      "args": [
        {"flag": "-r", "prompt": "random MAC? [y/N]", "bool": true},
        {"flag": "-m", "prompt": "or set specific MAC (aa:bb:cc:dd:ee:ff)"},
        {"flag": "iface", "prompt": "interface [wlan0]", "default": "wlan0"}
      ],
      "needs_root": true
    },
    "dalfox": {
      "bin": "dalfox",
      "pkg": null,
      "src": "go install github.com/hahwul/dalfox/v2@latest",
      "cat": "web",
      "desc": "fast XSS fuzzer (Go) — build kalau Go ada",
      "args": [
        {"flag": "url", "prompt": "target url (device own)", "required": true},
        {"flag": "--cookie", "prompt": "cookie (optional)"},
        {"flag": "--skip-bav", "prompt": "skip BAV? [y/N]", "bool": true}
      ]
    },
    "xsstrike": {
      "bin": "xsstrike",
      "pkg": null,
      "pip": "xsstrike",
      "cat": "web",
      "desc": "XSS detection + filter bypass (Python pip)",
      "args": [
        {"flag": "-u", "prompt": "target url (device own)", "required": true},
        {"flag": "--crawl", "prompt": "crawl? [y/N]", "bool": true},
        {"flag": "--level", "prompt": "level [3]", "default": "3"}
      ]
    },
    "feroxbuster": {
      "bin": "feroxbuster",
      "pkg": null,
      "src": "cargo install feroxbuster",
      "cat": "web",
      "desc": "async path/content fuzzer (Rust)",
      "args": [
        {"flag": "-u", "prompt": "target url (device own)", "required": true},
        {"flag": "-w", "prompt": "wordlist [subd.txt]", "default": "subd.txt"},
        {"flag": "-x", "prompt": "extensions (php,html...)"}
      ]
    },
    "responder": {
      "bin": "responder",
      "pkg": null,
      "pip": "responder",
      "cat": "net",
      "desc": "NBNS/LLMNR/mDNS poison (was Windows-only; Linux/own-network lab)",
      "args": [
        {"flag": "-I", "prompt": "interface [wlan0]", "default": "wlan0"},
        {"flag": "-w", "prompt": "disable wpad? [n]", "default": "n"}
      ]
    },
    "aircrack-ng": {
      "bin": "airmon-ng",
      "pkg": "aircrack-ng",
      "cat": "net",
      "desc": "WiFi toolkit: monitor mode + deauth (aireplay-ng -0), packet capture (airodump-ng)",
      "args": [
        {"flag": "iface", "prompt": "interface [wlan0]", "default": "wlan0"},
        {"flag": "-0", "prompt": "deauth count [10]", "default": "10"},
        {"flag": "-a", "prompt": "AP bssid (untuk deauth client / aireplay)", "required": true},
        {"flag": "-c", "prompt": "client mac (deauth target; blank=all)"}
      ],
      "needs_root": true,
      "notes": "monitor mode dulu: airmon-ng start wlan0 (atau ip link set wlan0 down && iw dev wlan0 set type monitor)"
    },
    "mhddos": {
      "bin": null,
      "pkg": null,
      "src": "pip",
      "cat": "load",
      "desc": "MHDDoS (multi-mode, Python) — load test own service",
      "md_only": true
    },
    "loic": {
      "bin": null,
      "pkg": null,
      "cat": "load",
      "desc": "LOIC (GUI/.NET) — guide only, tidak bisa jalur CLI",
      "md_only": true
    }
  },
  "categories": {
    "web": "Web vuln (sqli/xss/fuzz/mitm-proxy)",
    "net": "Network (MITM/DNS/capture/spoof)",
    "recon": "Recon (nmap)",
    "auth": "Auth brute (hydra)",
    "load": "Load test (ab/siege/wrk/goldeneye)"
  }
}
